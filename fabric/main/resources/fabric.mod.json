{
	"schemaVersion": 1,
	"id": "jython-mod",
	"version": "${version}",
	"name": "jython-mod",
	"description": "This is a mod that allows you to use python in minecraft.",
	"authors": [
		"RyanLuo2011"
	],
	"contact": {
		"sources": "https://github.com/RyanLuoJiayuan1120/jython-mod"
	},
	"license": "MIT",
	"icon": "assets/jython-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"preLaunch": [
			"net.luojiayuan.jython.mod.bytecode.BytecodeHook"
		],
		"main": [
			"net.luojiayuan.jython.mod.Jythonmod"
		],
		"client": [
			"net.luojiayuan.jython.mod.JythonModClient"
		],
		"server": [
			"net.luojiayuan.jython.mod.JythonModServer"
		]
	},
	"mixins": [
		"jython-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
	}
}